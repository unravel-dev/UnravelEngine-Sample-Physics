        {
         "type": "PhysicsSample.Station",
         "@slot": "3146c133-6ade-f54c-b105-91df494ef024",
         "order": 3,
         "title": "Forces and Fields",
         "description": "Sensors that push what is inside them: wind, anti-gravity, water and a magnet. Conveyor belts move their surfaces, barrels explode, and a lever changes gravity for the whole world.",
         "controls": "Push things into the fields, click a barrel to set it off, and press the lever to change gravity.",
