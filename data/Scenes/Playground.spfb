         "type": "PhysicsSample.Station",
         "@slot": "7ee421ed-8d23-d74f-8bd9-813ed84c38d2",
         "order": 1,
         "title": "Joint Workshop",
         "description": "Joints tie bodies together: hinges, sliders, ball joints, ropes and welds, with limits, springs, motors, friction and break forces.",
         "controls": "Push the doors and the bag, cross the bridge, and press the buttons to run the lift, the windmill, the wrecking ball, the cradle and the weight.",
